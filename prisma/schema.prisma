generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleUtilisateur {
  VENDEUR
  LIVREUR
  ADMINISTRATEUR
}

enum StatutCompte {
  EN_ATTENTE
  ACTIF
  REJETE
  SUSPENDU
}

enum StatutProduit {
  ACTIF
  INACTIF
}

enum StatutCommande {
  EN_ATTENTE_PAIEMENT
  PAYEE
  EN_PREPARATION
  PRETE_A_LIVRER
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

enum MoyenPaiement {
  ORANGE_MONEY
  MOOV_MONEY
}

enum StatutPaiement {
  EN_ATTENTE
  CONFIRME
  ECHOUE
  REMBOURSE
}

enum StatutLivraison {
  EN_ATTENTE
  ACCEPTEE
  EN_PREPARATION
  EN_COURS
  LIVREE
  ECHEC
  ANNULEE
}

enum StatutSignalement {
  OUVERT
  TRAITE
  REJETE
}

model Utilisateur {
  id             String          @id @default(cuid())
  email          String          @unique
  telephone      String          @unique
  motDePasseHash String
  nom            String
  prenom         String
  role           RoleUtilisateur
  statut         StatutCompte    @default(EN_ATTENTE)
  dateCreation   DateTime        @default(now())

  vendeur        Vendeur?
  livreur        Livreur?
  notifications  Notification[]
  signalements   Signalement[]

  @@map("utilisateurs")
}

model Vendeur {
  id            String      @id @default(cuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  nomBoutique   String
  description   String?

  produits      Produit[]

  @@map("vendeurs")
}

model Livreur {
  id                  String      @id @default(cuid())
  utilisateurId       String      @unique
  utilisateur         Utilisateur @relation(fields: [utilisateurId], references: [id])
  typeVehicule        String
  zone                String
  documentIdentiteUrl String?

  livraisons          Livraison[]

  @@map("livreurs")
}

model Categorie {
  id       String    @id @default(cuid())
  nom      String
  slug     String    @unique
  produits Produit[]

  @@map("categories")
}

model Produit {
  id             String          @id @default(cuid())
  nom            String
  description    String
  prix           Int
  stock          Int
  categorieId    String
  categorie      Categorie       @relation(fields: [categorieId], references: [id])
  vendeurId      String
  vendeur        Vendeur         @relation(fields: [vendeurId], references: [id])
  statut         StatutProduit   @default(ACTIF)
  dateCreation   DateTime        @default(now())

  photos         PhotoProduit[]
  lignesCommande LigneCommande[]
  avis           Avis[]

  @@map("produits")
}

model PhotoProduit {
  id            String  @id @default(cuid())
  produitId     String
  produit       Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  url           String
  estPrincipale Boolean @default(false)
  ordre         Int     @default(0)

  @@map("photos_produit")
}

model Commande {
  id                String         @id @default(cuid())
  numero            String         @unique
  nomAcheteur       String
  telephoneAcheteur String
  adresseLivraison  String
  montantTotal      Int
  statut            StatutCommande @default(EN_ATTENTE_PAIEMENT)
  dateCreation      DateTime       @default(now())

  lignes            LigneCommande[]
  paiement          Paiement?
  livraison         Livraison?
  avis              Avis[]

  @@map("commandes")
}

model LigneCommande {
  id           String   @id @default(cuid())
  commandeId   String
  commande     Commande @relation(fields: [commandeId], references: [id])
  produitId    String
  produit      Produit  @relation(fields: [produitId], references: [id])
  quantite     Int
  prixUnitaire Int

  @@map("lignes_commande")
}

model Paiement {
  id                   String         @id @default(cuid())
  commandeId           String         @unique
  commande             Commande       @relation(fields: [commandeId], references: [id])
  montant              Int
  moyenPaiement        MoyenPaiement
  referenceTransaction String?
  statut               StatutPaiement @default(EN_ATTENTE)
  dateCreation         DateTime       @default(now())

  @@map("paiements")
}

model Livraison {
  id                 String          @id @default(cuid())
  commandeId         String          @unique
  commande           Commande        @relation(fields: [commandeId], references: [id])
  livreurId          String?
  livreur            Livreur?        @relation(fields: [livreurId], references: [id])
  adresseDepart      String
  adresseDestination String
  statut             StatutLivraison @default(EN_ATTENTE)
  distance           Float?
  dateCreation       DateTime        @default(now())

  @@map("livraisons")
}

model Avis {
  id           String    @id @default(cuid())
  note         Int
  commentaire  String?
  produitId    String?
  produit      Produit?  @relation(fields: [produitId], references: [id])
  commandeId   String?
  commande     Commande? @relation(fields: [commandeId], references: [id])
  dateCreation DateTime  @default(now())

  @@map("avis")
}

model Notification {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  type          String
  message       String
  lu            Boolean     @default(false)
  dateCreation  DateTime    @default(now())

  @@map("notifications")
}

model Signalement {
  id            String            @id @default(cuid())
  utilisateurId String?
  utilisateur   Utilisateur?      @relation(fields: [utilisateurId], references: [id])
  sujet         String
  description   String
  statut        StatutSignalement @default(OUVERT)
  dateCreation  DateTime          @default(now())

  @@map("signalements")
}
